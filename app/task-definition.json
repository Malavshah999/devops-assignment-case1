{
  "family": "devops-case1",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::417492524162:role/devops-ecs-role",
  "containerDefinitions": [{
    "name": "app",
    "image": "417492524162.dkr.ecr.ap-south-1.amazonaws.com/devops-case1:latest",
    "portMappings": [{"containerPort": 3000}],
    "environment": [{"name": "JWT_SECRET", "value": "use_secrets_manager_in_prod"}],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/devops-case1",
        "awslogs-region": "ap-south-1",
        "awslogs-stream-prefix": "ecs"
      }
    }
  }]
}